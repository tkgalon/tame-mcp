# Copy to apps/web/.env.local. Local values come from `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
TAME_SITE_URL=http://localhost:3000

# Server only. Never prefix these with NEXT_PUBLIC.
TAME_SUPABASE_SECRET_KEY=
TAME_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
