  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tame/contracts": "workspace:*",
    "express": "5.3.0",
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
