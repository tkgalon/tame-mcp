{
  "name": "@tame/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=.env.local dist/index.js",
    "build": "tsc --build",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
