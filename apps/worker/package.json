{
  "name": "@tame/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=.env.local dist/index.js",
    "build": "tsc --build",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit --incremental false --composite false",
    "test": "pnpm build && node --test --test-reporter=spec"
  },
  "dependencies": {
    "@tame/contracts": "workspace:*",
    "@tame/parsers": "workspace:*",
    "zod": "4.6.7"
  }
}
