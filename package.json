{
  "name": "tame-mcp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm build:packages && pnpm --filter @tame/web dev",
    "dev:mcp": "pnpm build:packages && pnpm --filter @tame/mcp dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @tame/worker dev",
    "dev:packages": "pnpm --filter @tame/contracts dev",
    "build:packages": "pnpm --filter './packages/**' --recursive build",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm build:packages && pnpm --recursive typecheck",
    "check": "pnpm typecheck && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local",
    "test:db": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "test:upload": "pnpm --filter @tame/worker build && node scripts/upload.integration.mjs",
    "test:parsers": "pnpm --filter @tame/contracts test && pnpm --filter @tame/parsers test",
    "test:worker": "pnpm --filter @tame/worker test",
    "test:worker:integration": "pnpm --filter @tame/worker build && node scripts/worker.integration.mjs",
    "test:mcp": "pnpm --filter @tame/mcp test",
    "test:oauth": "pnpm --filter @tame/mcp build && node scripts/oauth.integration.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "pg": "8.23.1",
    "supabase": "2.122.0"
  }
}
